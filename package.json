{
  "name": "mercel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun --bun ultracite check",
    "dev": "bun --watch src/server.ts",
    "fix": "bun --bun ultracite fix",
    "prepare": "bun --bun lefthook install",
    "start": "bun src/server.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/lib-storage": "^3.1129.0",
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "@evyweb/ioctopus": "^1.4.1",
    "@getworkbench/elysia": "^0.9.1",
    "bullmq": "^6.3.4",
    "elysia": "^1.4.30",
    "evlog": "^2.28.1",
    "nanoid": "^6.0.1",
    "redis": "^6.2.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2",
    "ultracite": "7.11.1",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
