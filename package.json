{
  "name": "mercel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check check:root",
    "check:root": "bun --bun ultracite check package.json turbo.json tsconfig.base.json vitest.config.ts biome.jsonc .vscode/settings.json",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:reset": "turbo run db:reset",
    "db:studio": "turbo run db:studio",
    "dev": "turbo run dev",
    "dev:deploy": "turbo run dev --filter=deploy-worker",
    "dev:request": "turbo run dev --filter=request-handler-server",
    "dev:upload": "turbo run dev --filter=upload-server",
    "dev:web": "turbo run dev --filter=web-client",
    "fix": "turbo run fix fix:root",
    "fix:root": "bun --bun ultracite fix package.json turbo.json tsconfig.base.json vitest.config.ts biome.jsonc .vscode/settings.json",
    "lint:commit": "bun --bun commitlint",
    "prepare": "bun --bun lefthook install",
    "start": "turbo run start",
    "start:deploy": "turbo run start --filter=deploy-worker",
    "start:request": "turbo run start --filter=request-handler-server",
    "start:upload": "turbo run start --filter=upload-server",
    "start:web": "turbo run start --filter=web-client",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.1",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "catalog": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/lib-storage": "^3.1129.0",
    "@types/bun": "^1.4.2",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "evlog": "^2.28.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
