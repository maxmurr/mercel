# BullMQ Redis connection (matches compose.yml)
REDIS_URL=redis://localhost:6379

# Workbench dashboard auth. Generate a password with: openssl rand -hex 24
WORKBENCH_USER=admin
WORKBENCH_PASS=

# Local RustFS credentials only. Never use these in production.
RUSTFS_ACCESS_KEY=mercel-local
RUSTFS_SECRET_KEY=mercel-local-secret

# S3 uploads. Create the mercel bucket at http://localhost:9001 first.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mercel
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mercel-local
AWS_SECRET_ACCESS_KEY=mercel-local-secret
