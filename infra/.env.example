# Local k3d application credentials only. Never use these outside local development.
# Copy to infra/.env and create the mercel-runtime Secret in namespace mercel.
# Database, Redis, and S3 credentials must match the existing infrastructure Secrets.
DATABASE_URL=postgresql://mercel:mercel-local-secret@postgres.postgres.svc.cluster.local:5432/mercel
REDIS_URL=redis://default:mercel-local-secret@redis.redis.svc.cluster.local:6379
AWS_ACCESS_KEY_ID=mercel-local
AWS_SECRET_ACCESS_KEY=mercel-local-secret
WORKBENCH_USER=admin
WORKBENCH_PASS=mercel-local-secret
DEPLOY_TOKEN=mercel-local-deploy-token-not-for-production
BETTER_AUTH_SECRET=mercel-local-auth-secret-not-for-production

# Real credentials required. OAuth callback: http://localhost:3002/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENCODE_API_KEY=

# Optional hosted search credentials.
EXA_API_KEY=
