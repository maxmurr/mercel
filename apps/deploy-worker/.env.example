# Local service URLs (matches compose.yml defaults)
DATABASE_URL=postgresql://mercel:mercel-local-secret@localhost:5432/mercel
REDIS_URL=redis://localhost:6379

# Must match the upload server's bucket and credentials.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mercel
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mercel-local
AWS_SECRET_ACCESS_KEY=mercel-local-secret
