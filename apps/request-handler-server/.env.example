# Public local-development credentials only. Never use these outside local development.
# k3d defaults. Keep port-forwards from infra/README.md running.
PORT=3001

# Must match the upload server's bucket and credentials. No database or Redis needed.
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=mercel
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mercel-local
AWS_SECRET_ACCESS_KEY=mercel-local-secret
