{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_EXTENDS$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "outputs": [".next/types/**", "next-env.d.ts", "tsconfig.tsbuildinfo"]
    },
    "dev": { "passThroughEnv": ["PORT", "OPENCODE_API_KEY"] },
    "dev:mastra": { "passThroughEnv": ["OPENCODE_API_KEY"] },
    "start": { "passThroughEnv": ["PORT", "OPENCODE_API_KEY"] }
  }
}
