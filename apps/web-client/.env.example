# Public local-development credentials only. Never use these outside local development.
# k3d defaults. Keep port-forwards from infra/README.md running.
DATABASE_URL=postgresql://mercel:mercel-local-secret@127.0.0.1:15432/mercel
REDIS_URL=redis://default:mercel-local-secret@127.0.0.1:16379

# Real provider credentials required for model calls; no local substitute.
OPENCODE_API_KEY=

# Local auth secret. GitHub sign-in still requires your own OAuth app credentials.
BETTER_AUTH_SECRET=mercel-local-auth-secret-not-for-production
BETTER_AUTH_URL=http://localhost:3002
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required server-to-server publishing secret; same value in upload-server.
# Generate with openssl rand -base64 32. Never expose as NEXT_PUBLIC_*.
DEPLOY_TOKEN=

# Public, build-time origins. Set both before building for production.
NEXT_PUBLIC_UPLOAD_SERVER_URL=http://localhost:3000
# Deployment IDs become subdomains: http://abc12.localhost:3001/
NEXT_PUBLIC_PREVIEW_BASE_URL=http://localhost:3001
