# Database
DATABASE_URL=postgresql://mercel:mercel-local-secret@127.0.0.1:5432/mercel

# Redis
REDIS_URL=redis://localhost:6379

# Server-only key for the OpenCode Go provider.
OPENCODE_API_KEY=

# Auth
BETTER_AUTH_SECRET=<openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3002
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public, build-time origins. Set both before building for production.
NEXT_PUBLIC_UPLOAD_SERVER_URL=http://localhost:3000
# Deployment IDs become subdomains: http://abc12.localhost:3001/
NEXT_PUBLIC_PREVIEW_BASE_URL=http://localhost:3001
