# Local service URLs (matches compose.yml defaults)
DATABASE_URL=postgresql://mercel:mercel-local-secret@localhost:5432/mercel
REDIS_URL=redis://localhost:6379
PORT=3000

# Workbench dashboard auth. Generate a password with: openssl rand -hex 24
WORKBENCH_USER=admin
WORKBENCH_PASS=

# Local S3 credentials only. Create the mercel bucket at http://localhost:9001 first.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mercel
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mercel-local
AWS_SECRET_ACCESS_KEY=mercel-local-secret
